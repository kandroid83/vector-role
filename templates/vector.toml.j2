[api]
enabled = true
address = "127.0.0.1:8686"

[sources.demo_logs]
type = "demo_logs"
format = "json"
interval = 1

[sinks.clickhouse]
type = "clickhouse"
inputs = ["demo_logs"]
endpoint = "http://{{ clickhouse_host }}:{{ clickhouse_port }}"
database = "{{ clickhouse_database }}"
table = "{{ clickhouse_table }}"
